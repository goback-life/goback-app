{
  "dart.flutterSdkPath": ".fvm/versions/3.35.5",
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
    "source.fixAll": "explicit"
  },
  "files.exclude": {
    ".flutter-plugins": true,
    ".flutter-plugins-dependencies": true,
    "**/.dart_tool": true,
    "**/.DS_Store": true,
    "**/.fvm": true,
    "**/.git": true,
    "**/.hg": true,
    "**/.idea": true,
    "**/.svn": true,
    "**/*.freezed.dart": true,
    "**/*.g.dart": true,
    "**/*.tailor.dart": true,
    "**/CVS": true,
    "**/fastlane": true,
    "**/Thumbs.db": true,
    "codemagic.yaml": true,
    "custom_lint.log": true,
    "Gemfile*": true
  },
  "search.exclude": {
    "**/.git": true,
    "/.fvm": true,
    "/.dart_tool": true,
    "/.idea": true,
    "/build": true,
    "**/fastlane": true,
    "codemagic.yaml": true,
    "Gemfile*": true,
    "**/*.tailor.dart": true,
    "**/*.freezed.dart": true
  },
  "files.watcherExclude": {
    "/.fvm": true,
    "/.dart_tool": true,
    "/.idea": true,
    "/build": true,
    "**/fastlane": true,
    "codemagic.yaml": true,
    "Gemfile*": true
  },
  "runOnSave.commands": [
    {
      "globMatch": "**/assets/**",
      "command": "flutter.hotReload",
      "runIn": "vscode"
    },
    {
      "globMatch": ".env",
      "command": "flutter.hotReload",
      "runIn": "vscode"
    }
  ]
}